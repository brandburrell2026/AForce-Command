{
  "openapi": "3.1.0",
  "info": {
    "title": "AForce / TravelGate flight bridge",
    "version": "1.0.0",
    "description": "Explicit read-only flight checks. No user-session forwarding, account linking, passenger data or health data. fetchedAt is provider-fetch time, not an assurance of real-time airport information."
  },
  "paths": {
    "/api/travel/flight-status": {
      "post": {
        "operationId": "checkAForceTravelFlight",
        "security": [
          {
            "AForceSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TravelFlightRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated provider result or unavailable state. Cache-Control: private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TravelFlightResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid lookup request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not an enabled pilot member (AForce)"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "503": {
            "description": "Integration disabled or not configured"
          }
        }
      }
    },
    "/api/integrations/aforce/flight-status": {
      "post": {
        "operationId": "lookupTravelGateBridgeFlight",
        "security": [
          {
            "TravelGateIntegration": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TravelFlightRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated provider result or unavailable state. Cache-Control: private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TravelFlightResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid lookup request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not an enabled pilot member (AForce)"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "503": {
            "description": "Integration disabled or not configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AForceSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "AForce Clerk session, plus enabled internal pilot cohort."
      },
      "TravelGateIntegration": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated 64-hex-character integration credential. Server-side only."
      }
    },
    "schemas": {
      "TravelFlightRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flightNumber",
          "departureDate",
          "origin",
          "destination"
        ],
        "properties": {
          "flightNumber": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2,3}[0-9]{1,4}[A-Z]?$"
          },
          "departureDate": {
            "type": "string",
            "format": "date"
          },
          "origin": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      },
      "TravelFlightObservation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flightNumber",
          "departureDate",
          "origin",
          "destination",
          "status",
          "scheduledDeparture",
          "estimatedDeparture",
          "departureGate",
          "departureTerminal"
        ],
        "properties": {
          "flightNumber": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2,3}[0-9]{1,4}[A-Z]?$"
          },
          "departureDate": {
            "type": "string",
            "format": "date"
          },
          "origin": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "boarding",
              "delayed",
              "departed",
              "in_air",
              "landed",
              "cancelled",
              "diverted",
              "unknown"
            ]
          },
          "scheduledDeparture": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "estimatedDeparture": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "departureGate": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "departureTerminal": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          }
        }
      },
      "TravelFlightResponse": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "availability",
              "provider",
              "fetchedAt",
              "flight"
            ],
            "properties": {
              "version": {
                "const": 1
              },
              "availability": {
                "enum": [
                  "available",
                  "stale"
                ]
              },
              "provider": {
                "const": "flightaware"
              },
              "fetchedAt": {
                "type": "string",
                "format": "date-time"
              },
              "flight": {
                "$ref": "#/components/schemas/TravelFlightObservation"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "availability",
              "reason"
            ],
            "properties": {
              "version": {
                "const": 1
              },
              "availability": {
                "const": "unavailable"
              },
              "reason": {
                "enum": [
                  "not_connected",
                  "provider_unavailable",
                  "not_found",
                  "mismatch",
                  "invalid_response",
                  "rate_limited",
                  "unauthorized",
                  "not_enabled"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
