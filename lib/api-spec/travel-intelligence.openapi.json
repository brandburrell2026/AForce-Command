  "components": {
    "securitySchemes": {
      "AForceSession": {
        "type": "http",
        "scheme": "bearer"
      },
      "TravelGateSession": {
        "type": "http",
        "scheme": "bearer"
      },
      "BridgeKey": {
        "type": "http",
        "scheme": "bearer"
      },
      "ClerkWebhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "svix-signature",
        "description": "Verified by the official Clerk SDK with svix-id and svix-timestamp over the raw request body."
      }
    },
    "schemas": {
      "Flight": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flightNumber",
          "departureDate",
          "origin",
          "destination"
        ],
        "properties": {
          "flightNumber": {
            "type": "string"
          },
          "departureDate": {
            "type": "string",
            "format": "date"
          },
          "origin": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      },
      "Leg": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "flight",
          "departureAt",
          "arrivalAt",
          "originTimeZone",
          "destinationTimeZone"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "flight": {
            "$ref": "#/components/schemas/Flight"
          },
          "departureAt": {
            "type": "string",
            "format": "date-time"
          },
          "arrivalAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "originTimeZone": {
            "type": "string"
          },
          "destinationTimeZone": {
            "type": "string"
          },
          "departurePreparedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "arrivalPreparedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Trip": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "legs",
          "completedAt",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "legs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/Leg"
            }
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "State": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "trips"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "trips": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Trip"
            }
          }
        },
        "description": "Active flight identities must be unique across trips. Runtime validators enforce connected-leg chronology and valid IANA time zones."
      },
      "Sync": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "trips",
          "consent"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "trips": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Trip"
            }
          },
          "consent": {
            "const": true
          }
        }
      }
    }
  }
}
