{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  // S1-1 adds lib/db's first src/__tests__ directory; without this the test
  // file is compiled into the published package as dist/**/*.test.d.ts.
  // Integration suites are likewise test-only. They exercise API operations
  // across package boundaries and must not pull API source into this library's
  // declaration build. vitest.integration.config.ts still runs these suites.
  "exclude": ["src/**/__tests__/**", "src/**/__integration__/**"],
  "references": [
    {
      "path": "../health-core"
    }
  ]
}
