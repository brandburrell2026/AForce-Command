{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://aforce-command-production.up.railway.app/api"
      }
    },
    "demo": {
      "extends": "preview",
      "channel": "demo",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true"
      },
      "node": "22.13.0"
    },
    "internal": {
      "extends": "production",
      "channel": "internal",
      "env": {
        "EXPO_PUBLIC_INTERNAL_TESTFLIGHT": "true"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://aforce-command-production.up.railway.app/api",
        "PNPM_CONFIG_DANGEROUSLY_ALLOW_ALL_BUILDS": "true"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "node": "22.13.0"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6783984149",
        "appleTeamId": "DGB7CCRCTL"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
