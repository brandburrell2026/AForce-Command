{
  "expo": {
    "name": "AForce OS",
    "slug": "aforce-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aforce-os",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aforce.os",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "AForce OS uses your camera to scan hydration product barcodes.",
        "NSLocationWhenInUseUsageDescription": "AForce OS uses your location to show local temperature and humidity, which drive your personalized hydration recommendations.",
        "NSHealthShareUsageDescription": "AForce OS reads heart rate, HRV, sleep, and workout data from Apple Health to personalize your hydration and recovery score.",
        "NSMicrophoneUsageDescription": "AForce OS uses your microphone for voice coaching and audio interactions."
      }
    },
    "android": {
      "backgroundColor": "#0D0D0D",
      "package": "com.aforce.os",
      "versionCode": 1,
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#0D0D0D"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "AForce OS uses your camera to scan hydration product barcodes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AForce OS uses your location to show local temperature and humidity, which drive your personalized hydration recommendations."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "AForce OS uses your microphone for voice coaching and audio interactions."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C1281B"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c30ebfdb-7cce-475f-98f8-8ff14e58f5b3"
      }
    },
    "owner": "brandburrell2026",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/c30ebfdb-7cce-475f-98f8-8ff14e58f5b3"
    }
  }
}
