{
  "name": "@workspace/aforce-os",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eas:login": "pnpm dlx eas-cli@latest login",
    "eas:configure": "pnpm dlx eas-cli@latest init",
    "eas:build:dev": "pnpm dlx eas-cli@latest build --profile development --platform all",
    "eas:build:preview": "pnpm dlx eas-cli@latest build --profile preview --platform all",
    "eas:build:ios": "pnpm dlx eas-cli@latest build --profile production --platform ios",
    "eas:build:android": "pnpm dlx eas-cli@latest build --profile production --platform android",
    "eas:build:all": "pnpm dlx eas-cli@latest build --profile production --platform all",
    "eas:build:internal": "pnpm dlx eas-cli@latest build --profile internal --platform ios",
    "eas:submit:ios": "pnpm dlx eas-cli@latest submit --profile production --platform ios --latest",
    "eas:submit:ios:internal": "echo 'Submit internal builds by ID: pnpm dlx eas-cli@latest submit --platform ios --id <buildId> (never --latest \u2014 see docs/health/rollout/RC2-RULING-A-INTERNAL-TESTFLIGHT-OVERLAY.md)' && exit 1",
    "eas:submit:android": "pnpm dlx eas-cli@latest submit --profile production --platform android --latest",
    "eas-build-pre-install": "pnpm config set dangerously-allow-all-builds true --location project || true",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/cli": "54.0.23",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
