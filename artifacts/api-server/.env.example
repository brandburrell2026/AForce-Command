# CORS (src/app.ts)
#
# In production (NODE_ENV=production, structurally forced by the
# Dockerfile + artifact.toml) unset CORS_ALLOWED_ORIGINS never reflects —
# cross-origin credentialed requests are refused outright.
#
# Set a comma-separated allowlist for any real deployment:
# CORS_ALLOWED_ORIGINS=https://app.drinkaforce.com,https://drinkaforce.com

# Outside production, with no CORS_ALLOWED_ORIGINS set, the server does
# NOT reflect arbitrary origins by default. Set this to "1" only for a
# local dev workflow or a hosted preview (e.g. a *.replit.dev dev
# service) that intentionally serves the Expo web client from a browser
# origin — it makes the server reflect ANY origin with credentials:true,
# which is safe on a machine/preview only you use, but would let any
# hostile page make credentialed cross-origin reads if left on for a
# publicly reachable dev host with a live session.
# CORS_DEV_REFLECT=1

# AForce Spatial Studio AI edits (src/routes/spatialStudio.ts)
#
# The route POST /api/spatial-studio/edit calls Claude through the official
# SDK, which reads the key from this variable. Leave it unset and the route
# answers 503 ai_unavailable; the studio then shows "AI not configured".
# ANTHROPIC_API_KEY=
#
# Optional model override. Defaults to claude-opus-5-5.
# SPATIAL_STUDIO_MODEL=claude-opus-5-5
